---
import { WHATSAPP_PHONE } from '../data/pricing';

const defaultWhatsMessage = encodeURIComponent("Olá! Gostaria de informações e reservas de pistas no Novo Boliche Vila Maria.");
const whatsAppUrl = `https://wa.me/${WHATSAPP_PHONE}?text=${defaultWhatsMessage}`;
---

<header class="w-full bg-[#faf9f5] border-b border-zinc-200/80 sticky top-0 z-50 backdrop-blur-md bg-[#faf9f5]/90">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Left: Local Tagline -->
      <div class="flex items-center gap-2 text-xs font-semibold tracking-wider text-zinc-500 uppercase">
        <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
        <span class="hidden sm:inline">Vila Maria • Zona Norte SP</span>
        <span class="sm:hidden">Vila Maria, SP</span>
      </div>

      <!-- Center: Status / Nav -->
      <nav class="hidden lg:flex items-center gap-8 text-sm font-semibold text-zinc-700">
        <a href="#precos" class="hover:text-zinc-950 transition-colors">Preços</a>
        <a href="#simulador" class="hover:text-zinc-950 transition-colors">Simulador</a>
        <a href="#gastronomia" class="hover:text-zinc-950 transition-colors">Gastronomia</a>
        <a href="#aniversarios" class="hover:text-zinc-950 transition-colors">Aniversários</a>
        <a href="#faq" class="hover:text-zinc-950 transition-colors">Dúvidas</a>
        <a href="#localizacao" class="hover:text-zinc-950 transition-colors">Como Chegar</a>
      </nav>

      <!-- Right: CTA Button -->
      <div class="flex items-center gap-3">
        <a 
          href={whatsAppUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-2 px-4 sm:px-5 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-bold text-zinc-900 bg-yellow-400 hover:bg-yellow-300 border border-yellow-500/40 shadow-sm transition-all hover:scale-105 active:scale-95"
        >
          <span>Reservar Pista</span>
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.976.58 1.968.928 3.149.929 3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.299.144.347.491 1.2.534 1.288.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.174.449.741.964 1.2 201 1.028 1.139 1.192 1.312.087.058.174.043.245-.043.072-.087.318-.376.405-.506.086-.13.173-.101.289-.058.116.043.737.347.864.411.127.064.212.096.242.149.03.053.03.31-.114.715z"/>
          </svg>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button 
          id="mobile-menu-toggle"
          type="button" 
          aria-label="Abrir Menu" 
          class="lg:hidden p-2 rounded-full border border-zinc-300 text-zinc-700 hover:text-zinc-950 focus:outline-none"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-zinc-200 py-3 space-y-2">
      <a href="#precos" class="block px-3 py-2 rounded-lg text-sm font-semibold text-zinc-800 hover:bg-zinc-100">Preços & Pistas</a>
      <a href="#simulador" class="block px-3 py-2 rounded-lg text-sm font-semibold text-zinc-800 hover:bg-zinc-100">Simulador de Valor</a>
      <a href="#gastronomia" class="block px-3 py-2 rounded-lg text-sm font-semibold text-zinc-800 hover:bg-zinc-100">Cardápio & Porções</a>
      <a href="#aniversarios" class="block px-3 py-2 rounded-lg text-sm font-semibold text-zinc-800 hover:bg-zinc-100">Aniversários</a>
      <a href="#faq" class="block px-3 py-2 rounded-lg text-sm font-semibold text-zinc-800 hover:bg-zinc-100">Dúvidas Frequentes</a>
      <a href="#localizacao" class="block px-3 py-2 rounded-lg text-sm font-semibold text-zinc-800 hover:bg-zinc-100">Como Chegar</a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menuEl = document.getElementById('mobile-menu');
  if (toggleBtn && menuEl) {
    toggleBtn.addEventListener('click', () => {
      menuEl.classList.toggle('hidden');
    });
  }
</script>
