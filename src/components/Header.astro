---
import { WHATSAPP_PHONE } from '../data/pricing';

const defaultWhatsMessage = encodeURIComponent("Olá! Gostaria de informações e reservas de pistas no Novo Boliche Vila Maria.");
const whatsAppUrl = `https://wa.me/${WHATSAPP_PHONE}?text=${defaultWhatsMessage}`;
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-slate-950/85 border-b border-slate-800/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-amber-500 rounded-lg p-1">
        <div class="relative w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 via-rose-600 to-purple-700 flex items-center justify-center shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform duration-300">
          <!-- Bowling Ball & Pins SVG -->
          <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 6c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm4 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm-2 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1z"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-extrabold tracking-wider text-white group-hover:text-amber-400 transition-colors uppercase font-display">
            Novo Boliche
          </span>
          <span class="text-xs tracking-widest text-amber-400 font-semibold uppercase -mt-1">
            Vila Maria • SP
          </span>
        </div>
      </a>

      <!-- Center Status Badge: Aberto Agora / Fechado -->
      <div id="live-status-pill" class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-900 border border-slate-700/60 text-xs font-medium">
        <span id="live-status-dot" class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span id="live-status-text" class="text-slate-300">Carregando status...</span>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-slate-300">
        <a href="#precos" class="hover:text-amber-400 transition-colors">Preços & Pistas</a>
        <a href="#simulador" class="hover:text-amber-400 transition-colors">Simulador</a>
        <a href="#gastronomia" class="hover:text-amber-400 transition-colors">Gastronomia</a>
        <a href="#aniversarios" class="hover:text-amber-400 transition-colors">Aniversários</a>
        <a href="#faq" class="hover:text-amber-400 transition-colors">Dúvidas</a>
        <a href="#localizacao" class="hover:text-amber-400 transition-colors">Localização</a>
      </nav>

      <!-- Action Button -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href={whatsAppUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="relative inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm text-slate-950 bg-gradient-to-r from-amber-400 via-amber-500 to-amber-400 hover:from-amber-300 hover:to-amber-400 shadow-lg shadow-amber-500/25 hover:shadow-amber-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.976.58 1.968.928 3.149.929 3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.299.144.347.491 1.2.534 1.288.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.174.449.741.964 1.2 201 1.028 1.139 1.192 1.312.087.058.174.043.245-.043.072-.087.318-.376.405-.506.086-.13.173-.101.289-.058.116.043.737.347.864.411.127.064.212.096.242.149.03.053.03.31-.114.715z"/>
          </svg>
          <span>Reservar Pista</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex lg:hidden items-center">
        <button 
          id="mobile-menu-toggle"
          type="button" 
          aria-label="Abrir Menu" 
          class="p-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:bg-slate-800 focus:outline-none"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-800/80 py-4 space-y-3">
      <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-900/60 border border-slate-800 text-xs font-medium mb-3">
        <span class="inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        <span id="mobile-status-text" class="text-slate-300">Verificando horário...</span>
      </div>
      <a href="#precos" class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-850 hover:text-amber-400">Preços & Pistas</a>
      <a href="#simulador" class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-850 hover:text-amber-400">Simulador de Valor</a>
      <a href="#gastronomia" class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-850 hover:text-amber-400">Cardápio & Gastronomia</a>
      <a href="#aniversarios" class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-850 hover:text-amber-400">Aniversários & Eventos</a>
      <a href="#faq" class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-850 hover:text-amber-400">Perguntas Frequentes</a>
      <a href="#localizacao" class="block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-850 hover:text-amber-400">Como Chegar</a>
      <a 
        href={whatsAppUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-xl font-semibold text-sm text-slate-950 bg-amber-400 hover:bg-amber-300 mt-2"
      >
        <span>Falar no WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Real-time "Aberto Agora" detection logic
  function checkOpenStatus() {
    const now = new Date();
    // Brazil / SP timezone
    const day = now.getDay(); // 0 = Sunday, 1 = Monday, 2 = Tuesday, ..., 6 = Saturday
    const hours = now.getHours();
    const minutes = now.getMinutes();
    const timeVal = hours + minutes / 60;

    let isOpen = false;
    let nextText = "";

    // Schedule:
    // Mon (1): Closed
    // Tue (2) - Thu (4): 16:00 to 00:30 (next day 0.5)
    // Fri (5): 16:00 to 02:30 (next day 2.5)
    // Sat (6): 14:00 to 02:30 (next day 2.5)
    // Sun (0): 14:00 to 00:30 (next day 0.5)

    if (day >= 2 && day <= 4) {
      // Tue, Wed, Thu
      if (timeVal >= 16 || timeVal < 0.5) {
        isOpen = true;
      }
    } else if (day === 5) {
      // Friday
      if (timeVal >= 16 || timeVal < 2.5) {
        isOpen = true;
      }
    } else if (day === 6) {
      // Saturday
      if (timeVal >= 14 || timeVal < 2.5) {
        isOpen = true;
      }
    } else if (day === 0) {
      // Sunday
      if (timeVal >= 14 || timeVal < 0.5) {
        isOpen = true;
      }
    } else if (day === 1) {
      // Monday after midnight closing from Sunday
      if (timeVal < 0.5) {
        isOpen = true;
      }
    }

    const dotEl = document.getElementById('live-status-dot');
    const textEl = document.getElementById('live-status-text');
    const mobileTextEl = document.getElementById('mobile-status-text');

    if (isOpen) {
      if (dotEl) {
        dotEl.innerHTML = `
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        `;
      }
      const label = "Aberto Agora • Pistas Disponíveis";
      if (textEl) {
        textEl.innerText = label;
        textEl.className = "text-emerald-400 font-semibold";
      }
      if (mobileTextEl) {
        mobileTextEl.innerText = label;
        mobileTextEl.className = "text-emerald-400 font-semibold";
      }
    } else {
      if (dotEl) {
        dotEl.innerHTML = `<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>`;
      }
      const label = day === 1 ? "Fechado hoje (Segunda) • Abre Terça às 16h" : "Fechado no momento • Abre às 16h";
      if (textEl) {
        textEl.innerText = label;
        textEl.className = "text-slate-400";
      }
      if (mobileTextEl) {
        mobileTextEl.innerText = label;
        mobileTextEl.className = "text-slate-400";
      }
    }
  }

  checkOpenStatus();
  setInterval(checkOpenStatus, 60000);

  // Mobile Menu Toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menuEl = document.getElementById('mobile-menu');
  if (toggleBtn && menuEl) {
    toggleBtn.addEventListener('click', () => {
      menuEl.classList.toggle('hidden');
    });
  }
</script>
