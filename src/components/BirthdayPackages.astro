---
import { createWhatsAppUrl } from '../data/pricing';

const eventsWhatsUrl = createWhatsAppUrl("Olá! Gostaria de saber como funciona para comemorar meu aniversário / fazer um evento no Novo Boliche.");
---

<section id="eventos" class="py-20 bg-[#FAF6EE] text-[#181412] border-b-2 border-[#181412] relative overflow-hidden">
  <div class="max-w-[1380px] w-full mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="max-w-3xl mx-auto text-center mb-14 space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border-2 border-[#181412] text-[#181412] text-xs font-bold uppercase tracking-wider shadow-[2px_2px_0px_#181412]">
        <span class="w-2.5 h-2.5 rounded-full bg-[#C41E14] inline-block"></span>
        <span>Comemorações & Confraternizações</span>
      </div>

      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-display uppercase tracking-tightest text-[#181412]">
        VENHA FAZER SEU EVENTO CONOSCO
      </h2>

      <p class="text-sm sm:text-base text-[#524842] font-medium max-w-xl mx-auto">
        O espaço ideal para celebrar com amigos, família e colegas de trabalho. Pistas lado a lado, gastronomia artesanal e total flexibilidade.
      </p>
    </div>

    <!-- Editorial 3-Column Grid (Zero emojis, clean SVG iconography) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      
      <!-- Card 1: Aniversários Crianças & Adultos -->
      <div class="p-6 sm:p-8 rounded-2xl bg-white border-2 border-[#181412] shadow-[4px_4px_0px_#181412] flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-xl bg-[#FAF6EE] flex items-center justify-center border-2 border-[#181412] text-[#C41E14]">
            <!-- Geometric Cake/Celebration SVG -->
            <svg class="w-6 h-6 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V6a2 2 0 10-2 2h2zm-7 5h14a2 2 0 012 2v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4a2 2 0 012-2z" />
            </svg>
          </div>

          <h3 class="text-xl font-black font-display uppercase text-[#181412] tracking-tight">
            Aniversários de Crianças e Adultos
          </h3>

          <p class="text-xs sm:text-sm text-[#524842] leading-relaxed">
            Junte a família e os amigos nas pistas com pacotes personalizados de pistas + salgados, pizzas e chopp. Traga o bolo e os docinhos para cantar os parabéns!
          </p>

          <div class="pt-2 border-t border-[#181412]/15 text-xs text-[#181412] font-bold flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#C41E14]"></span>
            <span>Pistas automatizadas e espaço para cantar parabéns</span>
          </div>
        </div>

        <div class="text-[11px] font-mono text-[#524842] uppercase font-bold">
          Ambiente seguro e familiar
        </div>
      </div>

      <!-- Card 2: Confraternização de Empresas -->
      <div class="p-6 sm:p-8 rounded-2xl bg-white border-2 border-[#181412] shadow-[4px_4px_0px_#181412] flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-xl bg-[#FAF6EE] flex items-center justify-center border-2 border-[#181412] text-[#181412]">
            <!-- Geometric Users/Team SVG -->
            <svg class="w-6 h-6 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>

          <h3 class="text-xl font-black font-display uppercase text-[#181412] tracking-tight">
            Confraternização de Empresas
          </h3>

          <p class="text-xs sm:text-sm text-[#524842] leading-relaxed">
            10 pistas automatizadas com capacidade para receber até 60 jogadores simultâneos (6 por pista). Ideal para torneios internos, integração de times e festas de fim de ano.
          </p>

          <div class="pt-2 border-t border-[#181412]/15 text-xs text-[#181412] font-bold flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#C41E14]"></span>
            <span>Até 60 jogadores simultâneos</span>
          </div>
        </div>

        <div class="text-[11px] font-mono text-[#524842] uppercase font-bold">
          Torneios corporativos e happy hour
        </div>
      </div>

      <!-- Card 3: Comandas Individuais & Praticidade -->
      <div class="p-6 sm:p-8 rounded-2xl bg-white border-2 border-[#181412] shadow-[4px_4px_0px_#181412] flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-xl bg-[#FAF6EE] flex items-center justify-center border-2 border-[#181412] text-[#E04E22]">
            <!-- Geometric Receipt/Card SVG -->
            <svg class="w-6 h-6 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>

          <h3 class="text-xl font-black font-display uppercase text-[#181412] tracking-tight">
            Comandas Individuais
          </h3>

          <p class="text-xs sm:text-sm text-[#524842] leading-relaxed">
            Cada convidado consome e paga seu próprio consumo diretamente no balcão ou caixa, eliminando qualquer estresse ou confusão na hora de fechar a conta do grupo.
          </p>

          <div class="pt-2 border-t border-[#181412]/15 text-xs text-[#181412] font-bold flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#C41E14]"></span>
            <span>Zero complicação de divisão de conta</span>
          </div>
        </div>

        <div class="text-[11px] font-mono text-[#524842] uppercase font-bold">
          Praticidade para organizadores
        </div>
      </div>

    </div>

    <!-- Big Events CTA Banner -->
    <div class="mt-12 p-8 rounded-2xl bg-white border-2 border-[#181412] text-center space-y-5 max-w-3xl mx-auto shadow-[4px_4px_0px_#181412]">
      <div class="space-y-2">
        <h4 class="text-xl sm:text-2xl font-black font-display uppercase tracking-tight text-[#181412]">
          Quer planejar seu aniversário ou confraternização?
        </h4>
        <p class="text-xs sm:text-sm text-[#524842] max-w-lg mx-auto">
          Fale diretamente com a equipe do Novo Boliche para tirar dúvidas sobre reserva de pistas conjugadas e pacotes.
        </p>
      </div>

      <a 
        href={eventsWhatsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl font-bold text-xs sm:text-sm uppercase tracking-wider text-white bg-[#168B42] hover:bg-[#127236] border-[1.5px] border-[#0E5A2B] shadow-[3px_3px_0px_#181412] transition-all duration-200 hover:scale-105 active:scale-95 group"
      >
        <span>Planejar Meu Aniversário / Evento pelo WhatsApp</span>
        <svg class="w-6 h-6 shrink-0 fill-current group-hover:scale-110 transition-transform" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.976.58 1.968.928 3.149.929 3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.299.144.347.491 1.2.534 1.288.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.174.449.741.964 1.2 201 1.028 1.139 1.192 1.312.087.058.174.043.245-.043.072-.087.318-.376.405-.506.086-.13.173-.101.289-.058.116.043.737.347.864.411.127.064.212.096.242.149.03.053.03.31-.114.715z"/>
        </svg>
      </a>
    </div>

  </div>
</section>
