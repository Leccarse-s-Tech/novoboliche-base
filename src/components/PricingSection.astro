---
import { PRICING_DATA, WHATSAPP_PHONE } from '../data/pricing';
---

<section id="precos" class="py-20 bg-white border-y border-zinc-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Title -->
    <div class="max-w-3xl mx-auto text-center mb-16 space-y-3">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-zinc-500">
        Tarifas & Turnos
      </span>
      <h2 class="text-4xl sm:text-5xl font-black text-zinc-950 font-display tracking-tight">
        Preços Transparentes
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 font-sans">
        O valor da hora é por pista e comporta <strong>até 6 pessoas</strong>. Dividindo com os amigos, a diversão sai super em conta.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {PRICING_DATA.map((card) => {
        const whatsUrl = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(card.mensagemWhats)}`;
        const isWeekend = card.id === "sabado-domingo";

        return (
          <div class={`rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 border ${
            isWeekend
              ? "bg-[#faf9f5] border-zinc-900 shadow-float ring-1 ring-zinc-900"
              : "bg-white border-zinc-200 hover:border-zinc-400 shadow-soft"
          }`}>
            
            <div>
              <!-- Badge -->
              <div class="flex items-center justify-between mb-4">
                <span class="text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-zinc-100 text-zinc-800 border border-zinc-200">
                  {card.badge}
                </span>
                {isWeekend && (
                  <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full bg-yellow-400 text-zinc-950">
                    Fim de Semana
                  </span>
                )}
              </div>

              <!-- Day & Hours -->
              <h3 class="text-2xl font-black text-zinc-950 font-display tracking-tight">
                {card.dia}
              </h3>
              <p class="text-xs font-semibold text-zinc-500 mt-1 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Horário: {card.funcionamento}</span>
              </p>

              <!-- Turnos Breakdown -->
              <div class="mt-6 space-y-3">
                {card.turnos.map((turno) => (
                  <div class={`p-4 rounded-2xl border transition-all ${
                    turno.destaque 
                      ? "bg-white border-zinc-400 shadow-sm" 
                      : "bg-zinc-50/70 border-zinc-200"
                  }`}>
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-bold text-zinc-700 uppercase tracking-wide">
                        {turno.periodo}
                      </span>
                      {turno.destaque && (
                        <span class="text-[9px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-zinc-900 text-white">
                          Horário Nobre
                        </span>
                      )}
                    </div>
                    <div class="mt-2 flex items-baseline gap-1">
                      <span class="text-xs font-bold text-zinc-500">R$</span>
                      <span class="text-3xl font-black text-zinc-950 font-display">
                        {turno.valor}
                      </span>
                      <span class="text-xs text-zinc-500 font-medium">/ hora da pista</span>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Details Box -->
              <div class="mt-5 p-3 rounded-xl bg-zinc-50 border border-zinc-200 text-xs text-zinc-600 space-y-1">
                <div class="flex justify-between items-center">
                  <span>Capacidade máxima:</span>
                  <strong class="text-zinc-900 font-bold">Até 6 pessoas</strong>
                </div>
                <div class="flex justify-between items-center">
                  <span>Aluguel do sapato higienizado:</span>
                  <strong class="text-zinc-900 font-bold">R$ 7,00 (par)</strong>
                </div>
              </div>
            </div>

            <!-- CTA Button -->
            <div class="mt-8">
              <a 
                href={whatsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={`w-full flex items-center justify-center gap-2 py-3.5 px-4 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-200 ${
                  isWeekend
                    ? "bg-yellow-400 hover:bg-yellow-300 text-zinc-950 shadow-sm"
                    : "bg-zinc-950 hover:bg-zinc-800 text-white shadow-sm"
                }`}
              >
                <span>Reservar para {card.dia.split(" ")[0]}</span>
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.976.58 1.968.928 3.149.929 3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.299.144.347.491 1.2.534 1.288.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.174.449.741.964 1.2 201 1.028 1.139 1.192 1.312.087.058.174.043.245-.043.072-.087.318-.376.405-.506.086-.13.173-.101.289-.058.116.043.737.347.864.411.127.064.212.096.242.149.03.053.03.31-.114.715z"/>
                </svg>
              </a>
            </div>

          </div>
        );
      })}
    </div>

    <!-- Footnote -->
    <div class="mt-12 text-center text-xs text-zinc-500 flex flex-col sm:flex-row items-center justify-center gap-4 font-medium">
      <span>✓ Cobrança proporcional exata por fração de tempo</span>
      <span class="hidden sm:inline">•</span>
      <span>✓ Sapatos higienizados e esterilizados a cada partida</span>
      <span class="hidden sm:inline">•</span>
      <span>✓ Pistas modernas com pontuação automática</span>
    </div>

  </div>
</section>
