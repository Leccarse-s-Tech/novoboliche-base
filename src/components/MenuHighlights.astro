---
import { WHATSAPP_PHONE } from '../data/pricing';

const menuItems = [
  {
    category: "Porções de Boteco",
    items: [
      {
        name: "Batata Frita Especial",
        desc: "Crocante por fora e macia por dentro, coberta com cheddar cremoso derretido e bacon em cubinhos.",
        badge: "Favorita da Galera",
        price: "A partir de R$ 42,00"
      },
      {
        name: "Frango a Passarinho",
        desc: "Dourado e sequinho no alho frito e cheiro verde, servido com molho da casa e gomos de limão.",
        badge: "Clássico",
        price: "A partir de R$ 49,00"
      },
      {
        name: "Isca de Picanha na Chapa",
        desc: "Tiras suculentas aceboladas na manteiga de garrafa, com farofa crocante e vinagrete fresco.",
        badge: "Chapa Quente",
        price: "A partir de R$ 78,00"
      },
      {
        name: "Bolinhos de Queijo",
        desc: "Massa fininha e recheio de queijo derretido. O petisco perfeito entre uma jogada e outra.",
        badge: "Petisco",
        price: "A partir de R$ 38,00"
      }
    ]
  },
  {
    category: "Pizzas no Forno & Beirutes",
    items: [
      {
        name: "Pizza Mussarela Especial",
        desc: "Molho de tomate caseiro, camada farta de mussarela, tomates frescos e orégano aromático.",
        badge: "Forno de Pizza",
        price: "A partir de R$ 58,00"
      },
      {
        name: "Pizza Calabresa com Catupiry",
        desc: "Calabresa fatiada fina, cebola crocante e o legítimo requeijão Catupiry cremoso.",
        badge: "Tradicional",
        price: "A partir de R$ 62,00"
      },
      {
        name: "Beirute Filé Mignon",
        desc: "Pão sírio levemente tostado, filé mignon macio, queijo derretido, presunto, ovo e maionese artesanal.",
        badge: "Serve 2 pessoas",
        price: "A partir de R$ 54,00"
      },
      {
        name: "Burger Artesanal",
        desc: "Hambúrguer 160g suculento no pão brioche amanteigado, cheddar inglês e cebola caramelizada.",
        badge: "Com Fritas",
        price: "A partir de R$ 36,00"
      }
    ]
  },
  {
    category: "Chopp Trincando & Bar",
    items: [
      {
        name: "Chopp Claro na Caneca Congelada",
        desc: "Tirado a -2°C com colarinho cremoso impecável. O brinde oficial de cada strike!",
        badge: "Super Gelado",
        price: "Caneca 400ml"
      },
      {
        name: "Caipirinhas de Frutas",
        desc: "Limão tradicional, Morango ou Frutas Vermelhas preparadas com cachaça, vodka ou saquê.",
        badge: "Refrescante",
        price: "Individual"
      },
      {
        name: "Drinks Autorais & Clássicos",
        desc: "Gin Tônica aromática com especiarias, Aperol Spritz, Moscow Mule e Mojito refrescante.",
        badge: "Coquetelaria",
        price: "Cardápio Bar"
      },
      {
        name: "Sucos Naturais e Refrigerantes",
        desc: "Opções geladas sem álcool para motoristas da rodada, adolescentes e crianças.",
        badge: "Sem Álcool",
        price: "Lata e Jarra"
      }
    ]
  }
];

const menuWhatsUrl = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent("Olá! Gostaria de consultar o cardápio completo de porções e bebidas do Novo Boliche.")}`;
---

<section id="gastronomia" class="py-20 bg-white border-t border-zinc-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Title -->
    <div class="max-w-3xl mx-auto text-center mb-16 space-y-3">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-zinc-500">
        Comida de Verdade & Bar Completo
      </span>
      <h2 class="text-4xl sm:text-5xl font-black text-zinc-950 font-display tracking-tight">
        Gastronomia & Chopp
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 font-sans">
        Peça direto na sua pista enquanto joga, ou acomode-se confortavelmente em nossas mesas de restaurante e bar.
      </p>
    </div>

    <!-- Categories -->
    <div class="space-y-12">
      {menuItems.map((category) => (
        <div>
          <div class="flex items-center gap-3 mb-6">
            <h3 class="text-2xl font-black text-zinc-950 font-display">
              {category.category}
            </h3>
            <div class="flex-1 h-px bg-zinc-200"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {category.items.map((item) => (
              <div class="rounded-2xl bg-[#faf9f5] border border-zinc-200/90 p-6 flex flex-col justify-between hover:border-zinc-400 transition-all group">
                <div>
                  <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-white text-zinc-700 border border-zinc-200 inline-block mb-3">
                    {item.badge}
                  </span>
                  <h4 class="text-base font-bold text-zinc-950 group-hover:text-amber-600 transition-colors">
                    {item.name}
                  </h4>
                  <p class="text-xs text-zinc-600 mt-2 leading-relaxed">
                    {item.desc}
                  </p>
                </div>

                <div class="pt-4 mt-4 border-t border-zinc-200 flex items-center justify-between text-xs">
                  <span class="text-zinc-500 font-medium">{item.price}</span>
                  <span class="text-zinc-900 font-bold group-hover:translate-x-0.5 transition-transform">
                    Pedir na pista →
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Call to action -->
    <div class="mt-14 p-8 rounded-3xl bg-[#faf9f5] border border-zinc-200 max-w-3xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
      <div class="space-y-1">
        <h4 class="text-lg font-bold text-zinc-950 font-display">Quer ver o cardápio completo com todas as opções?</h4>
        <p class="text-xs text-zinc-600">Mais de 40 opções de porções, pizzas, hambúrgueres, sobremesas e coquetéis.</p>
      </div>

      <a 
        href={menuWhatsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="whitespace-nowrap px-6 py-3.5 rounded-full font-bold text-xs uppercase tracking-wider text-zinc-950 bg-yellow-400 hover:bg-yellow-300 border border-yellow-500/40 shadow-sm transition-all"
      >
        Pedir Cardápio Completo
      </a>
    </div>

  </div>
</section>
